<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="bookpool"/>
    <springProperty scope="context" name="ACTIVE_PROFILE" source="spring.profiles.active" defaultValue="default"/>

    <springProfile name="local,dev,default">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] [traceId=%X{traceId:-} userId=%X{userId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <fieldName>@timestamp</fieldName>
                    </timestamp>
                    <version>
                        <fieldName>schema</fieldName>
                    </version>
                    <logLevel/>
                    <loggerName/>
                    <threadName/>
                    <message/>
                    <stackTrace/>
                    <mdc/>
                    <pattern>
                        <pattern>
                            {
                            "app": "${APP_NAME}",
                            "profile": "${ACTIVE_PROFILE}"
                            }
                        </pattern>
                    </pattern>
                </providers>
            </encoder>
        </appender>
        <root level="${LOG_LEVEL_ROOT:-INFO}">
            <appender-ref ref="JSON"/>
        </root>
        <logger name="kr.co.bookpool" level="${LOG_LEVEL_APP:-INFO}"/>
    </springProfile>
</configuration>
