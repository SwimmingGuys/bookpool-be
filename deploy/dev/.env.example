# deploy/dev/.env  (이 파일을 .env 로 복사 — 커밋 금지)
# 앱 시크릿은 application-secret.yml 에 있다. 여기는 "mysql 컨테이너 부트스트랩" 값만.
# compose 변수치환(${...})에 쓰이며, docker compose 가 같은 폴더의 .env 를 자동으로 읽는다.

MYSQL_DATABASE=bookpool
MYSQL_ROOT_PASSWORD=change-me-root

# ↓ application-secret.yml 의 DB.DEV.USERNAME / DB.DEV.PASSWORD 와 반드시 동일해야 한다
DB_DEV_USERNAME=bookpool
DB_DEV_PASSWORD=change-me
