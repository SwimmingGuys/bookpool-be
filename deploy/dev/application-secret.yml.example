# 이 파일을 application-secret.yml 로 복사해 값 채우기 (실제 파일은 커밋 금지).
# app 컨테이너의 /app/config/application-secret.yml 로 마운트되어 dev 프로필이 로드한다.
# 호스트는 컨테이너 네트워크 서비스명(mysql, redis)을 쓴다 — localhost 아님!

# DB (dev datasource) — USERNAME/PASSWORD 는 .env 의 DB_DEV_* 와 반드시 동일해야 한다
DB:
  DEV:
    URL: jdbc:mysql://mysql:3306/bookpool?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    USERNAME: bookpool
    PASSWORD: change-me
    DRIVER_CLASS_NAME: com.mysql.cj.jdbc.Driver

# Redis — 컨테이너 서비스명
REDIS:
  HOST: redis
  PORT: 6379

# JWT
JWT:
  SECRET: change-me-to-a-long-random-secret-at-least-32-bytes

# Mail (dev 프로필은 app.mail.smtp.enabled=true 라 실제 발송)
MAIL:
  HOST: smtp.gmail.com
  PORT: 587
  USERNAME: your-gmail@gmail.com
  PASSWORD: your-16-char-app-password
  FROM: your-gmail@gmail.com

# swagger.server-url 은 application-dev.yml 에 기본값이 있으므로 여기 불필요.
# 도메인이 다르면 compose 에 SWAGGER_SERVER_URL 환경변수로 오버라이드.
