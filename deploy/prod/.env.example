# 이 파일을 서버의 ~/bookpool/.env 로 만든다 (커밋 금지, 권한 600).
# CD 워크플로가 GitHub Secret(ENV_FILE)의 내용을 그대로 이 파일로 기록한다.
#
# 셸 변수라 점(.)을 쓸 수 없어 밑줄 이름으로 담는다.
# compose가 컨테이너에 넣을 때 DB.PROD.URL 같은 점 이름으로 바꿔 준다.

# ---- 도메인 / TLS ----
# SITE_DOMAIN 은 certbot 발급(init-cert.sh)과 앱의 CORS 허용 오리진에 쓰인다.
# nginx.conf 는 server_name _ 로 두어 도메인이 박혀 있지 않다.
SITE_DOMAIN=bookpool.co.kr
# 인증서 만료 경고 메일을 받을 주소
ACME_EMAIL=you@example.com

# ---- 이미지 (GHCR) ----
REGISTRY=ghcr.io
APP_IMAGE_NAME=swimmingguys/bookpool-be
WEB_IMAGE_NAME=swimmingguys/bookpool-fe

# ---- MySQL ----
MYSQL_DATABASE=bookpool
MYSQL_ROOT_PASSWORD=change-me-root
# 아래 두 값이 곧 앱의 DB 접속 계정이다 (compose가 양쪽에 같이 넣는다)
DB_PROD_USERNAME=bookpool
DB_PROD_PASSWORD=change-me

# ---- 앱 ----
# 최소 32바이트. openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# ---- 메일 (이메일 인증코드 발송) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=noreply@bookpool.co.kr

# ---- 알림 (선택) ----
DISCORD_WEBHOOK_URL=
DISCORD_ALERT_ENABLED=false
