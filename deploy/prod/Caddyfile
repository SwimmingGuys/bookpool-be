# 운영 진입점. Caddy가 Let's Encrypt 인증서를 자동 발급·갱신한다.
# (dev의 nginx + certbot 수동 갱신을 대체)
#
# 전제: DNS A레코드가 이 서버를 가리키고 80/443이 열려 있어야 발급된다.

{
	# 발급 실패·만료 알림을 받을 주소
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# API — 경로를 그대로 넘긴다(앱이 /api 프리픽스를 기대).
	# Caddy는 X-Forwarded-For/Proto/Host를 자동으로 붙이므로
	# 앱의 forward-headers-strategy: framework 가 https를 정확히 인식한다.
	handle /api/* {
		reverse_proxy app:8080
	}

	# actuator는 컨테이너 내부 헬스체크에만 쓴다.
	# /actuator/prometheus 등이 외부에 열리지 않도록 막는다.
	handle /actuator/* {
		respond 404
	}

	# 그 외 전부 SPA. 정적 서빙과 딥링크 폴백은 web 이미지의 nginx가 처리한다.
	handle {
		reverse_proxy web:80
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
